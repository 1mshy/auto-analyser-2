# Environment Configuration

# MongoDB
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=stock_analyzer

# Server
# Bind to 0.0.0.0 to accept connections from other machines on the LAN.
# Use 127.0.0.1 if you want to restrict access to the host only.
SERVER_HOST=0.0.0.0
SERVER_PORT=3333

# Analysis
ANALYSIS_INTERVAL_SECS=3600  # 1 hour between cycles
YAHOO_REQUEST_DELAY_MS=100   # Delay between Yahoo Finance requests (tested: 100ms works fine locally)
YAHOO_CONCURRENCY=5          # Number of concurrent Yahoo Finance requests (tested: up to 10 works locally)
NASDAQ_REQUEST_DELAY_MS=500  # Delay between NASDAQ API requests

# Market universe
# US/NASDAQ remains primary; these Yahoo-compatible Canadian tickers are merged in.
CANADIAN_SYMBOLS=SHOP.TO,RY.TO,TD.TO,BNS.TO,BMO.TO,CM.TO,ENB.TO,CNQ.TO,CNR.TO,CP.TO

# Cache
CACHE_TTL_SECS=300           # 5 minutes for stock data
NEWS_CACHE_TTL_SECS=900      # 15 minutes for news (more time-sensitive)

# AI analysis (Optional - for AI-powered stock analysis)
# Any OpenAI-compatible endpoint works. Default is OpenRouter; the model is
# always discovered from the endpoint's /models list, never hardcoded.
#
# Option A - OpenRouter (cloud, needs a key, uses the `:free` model tier):
# Get your API key from: https://openrouter.ai/keys
# OPENROUTER_API_KEY_STOCKS=sk-or-v1-xxxx
#
# Option B - self-hosted vLLM / llama.cpp / LM Studio (no key needed):
# AI_BASE_URL=http://10.150.0.30:1234/v1
# AI_API_KEY=                # Only if the server was started with --api-key
OPENROUTER_ENABLED=true      # Set to false to disable AI even when configured

# Marketaux news (Optional - for the per-stock News card on StockDetail)
# Free tier: 100 requests/day. Get a key at https://www.marketaux.com/
# MARKETAUX_API_KEY=
MARKETAUX_ENABLED=true       # Set to false to disable even if API key is set
NEWS_SUMMARY_MIN_ARTICLES=2  # Skip the OpenRouter summary call below this article count

# Notifications / alert engine
NOTIFICATIONS_ENABLED=true   # Master switch. API CRUD keeps working when false; rules just don't fire.
# PUBLIC_BASE_URL=http://localhost:5173  # Used to link from Discord embeds back to the stock detail page
