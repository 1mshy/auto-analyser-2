# Frontend environment variables (Vite).
#
# Only variables prefixed with VITE_ are exposed to the client bundle, and they
# are INLINED AT BUILD TIME -- they are not read at runtime. Copy this file to
# .env (or .env.local) for local development. Both are gitignored.
#
# Leave both unset for the production/Docker deployment: nginx serves the SPA
# and reverse-proxies /api and /ws to the backend on the same origin, and the
# defaults below already do the right thing.

# Backend API origin override. A trailing slash is stripped automatically.
# Unset/empty  -> same-origin relative requests (/api/...), which the Vite dev
#                 server proxies to http://localhost:3333 (see vite.config.ts)
#                 and nginx proxies to backend:3333 in Docker.
# Example      -> VITE_API_URL=http://localhost:3333
VITE_API_URL=

# WebSocket origin or full URL override for /ws.
# Unset/empty            -> same-origin: ws(s)://<current host>/ws
# host[:port]            -> ws(s)://<value>/ws, protocol chosen from the page
#                           (wss when the page is https)
# ws:// or wss:// prefix -> used verbatim
# Example                -> VITE_WS_URL=localhost:3333
VITE_WS_URL=
